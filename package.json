  "private": true,
  "description": "Google Antigravity 桌面端中文套件：简体中文深度汉化 + 对话上下文与 Token 用量看板，跨平台统一安装、还原与诊断工具",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "upstream": {
    "chineseLocalization": {
      "repo": "antigravity-cn-community/Antigravity-Chinese-Localization",
